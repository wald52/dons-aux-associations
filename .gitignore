# Dépendances
node_modules/

# Caches et fichiers de travail du pipeline (jamais versionnés)
data/tmp/
data/_tmp_*
data/raw/
*.tmp

# Données brutes téléchargées : re-téléchargeables par les scripts de fetch,
# elles n'ont pas à peser dans le dépôt (cf. CLAUDE.md § Hygiène du dépôt).
data/*.csv
data/*.xlsx

# Captures d'écran : ni référencées par le site, ni utiles à la reconstruction.
screenshot*.png

# Relevés de mesure : seuls les jalons sont versionnés (bench/v0.json, etc.),
# pas les essais intermédiaires.
bench/tmp-*.json

# Téléchargements bruts du pipeline : reconstructibles par les scripts fetch_*,
# traçables par data/sources-manifest/ (URL + sha256). Ne pas versionner.
data/raw/

# Parties intermédiaires du pipeline : seul l'assemblage final est versionné.
data/canonical/parts/
__pycache__/
*.pyc

# Fichiers .js de l'ancien site : leur contenu est intégralement absorbé dans
# data/canonical/, qui est versionné. Les garder ferait dépasser la limite de
# 1 Go de GitHub Pages. Pour rejouer normalize_legacy.py, les récupérer depuis
# l'historique : git checkout 0b14348 -- data/sources
data/sources/

# Le banc de mesure installe playwright hors du dépôt ; rien à ignorer ici.
